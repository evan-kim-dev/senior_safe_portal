# 이 파일을 .env.local 로 복사해 값을 채운다. 실제 값은 커밋하지 않는다.

# 브라우저(로그인·게시판)에서 쓰는 공개 값
# anon 키는 번들에 노출되는 것이 정상이다. 전 테이블/스토리지 RLS 가 전제다.
# service_role 은 NEXT_PUBLIC_ 으로 절대 두지 않는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 API 에서 쓰는 값. 비우면 NEXT_PUBLIC_ 값을 쓴다.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 서버 전용. 링크 검사 6시간 캐시와 "오늘 위험한 영상" 집계에 필요하다. 절대 NEXT_PUBLIC_ 으로 만들지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 선택. Edge Function 의 INTERNAL_API_SECRET 과 같은 값을 넣으면 Next 서버만 analyze-link·chat-agent 를 부를 수 있다.
EDGE_INTERNAL_SECRET=

# 피드 자동 갱신(Vercel Cron → refresh-*-feeds). Supabase Edge Secrets 의 CRON_SECRET 과 같아야 한다.
CRON_SECRET=

# 선택. debug | info | warn | error (기본 info)
LOG_LEVEL=
